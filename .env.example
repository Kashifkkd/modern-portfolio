# Copy to .env.local (gitignored) and fill in. On Vercel, add the same keys under
# Project Settings > Environment Variables.

# Jarvis (the chat assistant). Create a key at https://build.nvidia.com/settings
NVIDIA_API_KEY=
# Optional: any chat model from build.nvidia.com. Default: meta/llama-3.3-70b-instruct
NVIDIA_MODEL=
